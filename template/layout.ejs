<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= frontmatter.title %> ‹ Tota Scriptura</title>

    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <link rel="canonical" href="https://totascriptura.org<%= url %>">
    <link rel="stylesheet" href="/asset/style.css?<%= cacheBust %>">
    
    <link rel="preconnect" href="https://use.typekit.net">
    <link rel="preconnect" href="https://use.typekit.net" crossorigin>
    <link rel="preconnect" href="https://kit.fontawesome.com" crossorigin>
    <link rel="preconnect" href="https://ka-p.fontawesome.com" crossorigin>
    <link rel="stylesheet" href="https://use.typekit.net/exn2xvh.css">
    <link rel="stylesheet" href="https://kit.fontawesome.com/4a9f54cbf1.css" crossorigin="anonymous">
    
    <link rel="icon" href="/asset/favicon.ico?<%= cacheBust %>" sizes="16x16 32x32">
    <link rel="icon" type="image/png" href="/asset/favicon-96x96.png?<%= cacheBust %>" sizes="96x96">
    <link rel="apple-touch-icon" href="/asset/apple-touch-icon-180x180.png?<%= cacheBust %>">
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#161616" media="(prefers-color-scheme: dark)">
    <meta name="description" content="<%= description %>">
    <meta property="og:site_name" content="Tota Scriptura">
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= frontmatter.title %>">
    <meta property="og:description" content="<%= description %>">
    <meta property="og:url" content="https://totascriptura.org<%= url %>">
<% if (hero) { %>    <meta property="og:image" content="https://totascriptura.org<%= hero.url %>">
<% } %>    <meta name="twitter:card" content="<%= hero && hero.wide ? 'summary_large_image' : 'summary' %>">
    <meta name="format-detection" content="telephone=no"><% if (frontmatter.planned || noindex) { %><meta name="robots" content="noindex"><% } %>
    
</head>
<body<% if (bodyClasses.length) { %> class="<%= bodyClasses.join(' ') %>"<% } %>>
    <header>
        <a href="/"><span class="site-logo fa-sharp fa-solid fa-feather-pointed" aria-hidden="true"></span> <span class="site-title">Tota Scriptura</span></a>
    </header>
    <main>
        <article>
            <header>
                <h1><%= frontmatter.title %></h1>
                <% if (frontmatter['quick nav']) { %>
                <nav class="quick-nav" aria-label="Quick links">
                    <ul>
                        <li><a href="/index/featured">Featured<span class="visually-hidden"> topics</span></a></li>
                        <li><a href="/index/alphabetical/topic">Alphabetical<span class="visually-hidden"> index</span></a></li>
                    </ul>
                </nav>
                <% } else if (featured || featuredWith) { %><span class="featured-badge fa-sharp fa-solid fa-star" role="img" aria-label="Featured"></span><% } %>
            </header>
            
            <% if (frontmatter.draft) { %>
            <div class="message"><p><span class="fa-sharp fa-solid fa-pencil" aria-hidden="true"></span> <%= view === "notes" ? "These notes are" : `This ${(nsLabel || "page").toLowerCase()} is` %> a working draft.</p></div>
            <% } %>
            
            <%- content %>

            <% if (subcategories.length > 0) { %>
            <section>
                <h2>Subcategories</h2>
                <ul>
                    <% subcategories.forEach(function(sub) { %>
                    <li><a href="<%= sub.url %>"><%= sub.title %></a></li>
                    <% }); %>
                </ul>
            </section>
            <% } %>
    
            <% if (pages.length > 0) { %>
            <section>
                <h2>Pages in this category</h2>
                <ul>
                    <% pages.forEach(function(page) { %>
                    <li><a href="<%= page.url %>"><%= page.title %></a></li>
                    <% }); %>
                </ul>
            </section>
            <% } %>
    
            <% if (categories.length) { %>
            <p class="categories">
                <span class="categories-icon fa-sharp fa-solid fa-tags fa-rotate-90" aria-hidden="true"></span>
                <a class="index-link" href="/index/categorical">Categories</a>:
                <% categories.forEach(function(cat, i) { %>
                <a href="<%= cat.url %>"><%= cat.title %></a><%= i < categories.length - 1 ? ', ' : '' %>
                <% }); %>
            </p>
            <% } %>
        </article>
    </main>
    
    <%_ if (nsLabel) { _%>
    <h2 id="page-actions" class="visually-hidden">Page actions</h2>
    <nav class="page-actions" aria-labelledby="page-actions">
        <ul>
            <%_ if (!view || view === "page") { _%>
            <li class="topic selected" aria-current="page"><%= nsLabel %></li>
            <%_ } else if (!pageUrl) { _%>
            <li class="topic muted"><%= nsLabel %></li>
            <%_ } else { _%>
            <li class="topic"><a href="<%= pageUrl %>"><%= nsLabel %></a></li>
            <%_ } _%>

            <%_ if (view) { _%>
            <%_ if (view === "notes") { _%>
            <li class="notes selected" aria-current="page">Notes</li>
            <%_ } else if (noteUrl) { _%>
            <li class="notes"><a href="<%= noteUrl %>">Notes</a></li>
            <%_ } else { _%>
            <li class="notes muted">Notes</li>
            <%_ } _%>

            <%_ if (view === "backlinks") { _%>
            <li class="backlinks selected" aria-current="page">Backlinks</li>
            <%_ } else if (backlinksUrl) { _%>
            <li class="backlinks"><a href="<%= backlinksUrl %>">Backlinks</a></li>
            <%_ } _%>
            <%_ } _%>
        </ul>
    </nav>
    <%_ } _%>

    <h2 id="site-navigation" class="visually-hidden">Site navigation</h2>
    <nav class="site-navigation" aria-labelledby="site-navigation">
        <div>
            <ul>
                <li><a href="/index/featured">Featured topics</a></li>
                <li><a href="/index/alphabetical/topic">Alphabetical index</a></li>
                <li><a href="/index/categorical">Categorical index</a></li>
                <li><a href="/index/scripture">Scripture index</a></li>
                <li><a href="/random">Random page</a></li>
            </ul>
        </div>

        <div>
            <ul>
                <li><a href="/">Home page</a></li>
                <li><a href="/about">About this project</a></li>
            </ul>

            <form action="/search" method="GET" role="search">
                <input type="search" name="q" placeholder="Search" aria-label="Search">
                <button type="submit" aria-label="Search"><span class="fa-sharp fa-solid fa-magnifying-glass" aria-hidden="true"></span></button>
            </form>
        </div>
    </nav>
    
    <footer>
        <p class="print-source">Retrieved from https://totascriptura.org<%= url %><span class="print-date"></span>.</p>
        <p>Copyright &copy; 2009–<%= new Date().getFullYear() %> Joey Day</p>
        <p><a href="/about">About</a> &middot; <a href="/colophon">Colophon</a></p>
    </footer>

	<script type="module" src="/asset/css-naked.js?<%= cacheBust %>"></script>
	<script type="module" src="/asset/print.js?<%= cacheBust %>"></script>
</body>
</html>