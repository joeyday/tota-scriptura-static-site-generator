{
  "name": "tsgen",
  "version": "0.23.6",
  "private": true,
  "description": "Bespoke static site generator for totascriptura.org",
  "type": "module",
  "license": "MIT",
  "bin": {
    "tsgen": "build.js"
  },
  "files": [
    "build.js",
    "serve.js",
    "lib/",
    "template/"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "fuzz": "node test/fuzz/bible.fuzz.js",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include='lib/**' --test-coverage-include=build.js --test-coverage-include=serve.js test/*.test.js",
    "lint": "standard",
    "fix": "standard --fix"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ejs": "^4.0.1",
    "markdown-it": "^14.3.2",
    "markdown-it-attrs": "^4.3.1",
    "markdown-it-bracketed-spans": "^1.0.1",
    "markdown-it-container": "^4.0.0",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "pagedjs": "^0.4.3",
    "puppeteer-core": "^25.15.0",
    "slugify": "^1.6.6",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "standard": "^17.1.2"
  }
}
